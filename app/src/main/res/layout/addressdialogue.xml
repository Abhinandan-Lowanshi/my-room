<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_marginHorizontal="@dimen/_30sdp"
    app:cardCornerRadius="@dimen/_8sdp"
    android:elevation="@dimen/_8sdp"
    android:layout_gravity="center"
    app:cardElevation="@dimen/_8sdp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_alignParentEnd="true"
            android:id="@+id/img_close"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/ic_baseline_close_24"
            android:layout_height="@dimen/_20sdp"
            ></androidx.appcompat.widget.AppCompatImageView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_40sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Just press and hold above your house"
            android:textAlignment="center"
            android:layout_below="@id/img_close"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"></androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_text"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Green circle swan on basis or your current location or custome location"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"></androidx.appcompat.widget.AppCompatTextView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_below="@id/message"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="@dimen/_30sdp"
            android:layout_marginHorizontal="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_height="wrap_content"
            >
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              app:cardBackgroundColor="@color/red"
              android:layout_height="@dimen/_25sdp"
              android:id="@+id/card_Close"
              app:cardCornerRadius="@dimen/_5sdp"
              >
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:textSize="@dimen/_11sdp"
                   android:layout_gravity="center"
                   android:textColor="@color/white"
                   android:text="@string/close"
                   ></TextView>
          </androidx.cardview.widget.CardView>


        </LinearLayout>
    </RelativeLayout>


</androidx.cardview.widget.CardView>
