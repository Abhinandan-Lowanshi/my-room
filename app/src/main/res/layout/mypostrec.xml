<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    app:cardCornerRadius="@dimen/_5sdp"
    android:elevation="@dimen/_2sdp"
    app:cardElevation="@dimen/_2sdp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/rl_main"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_height="wrap_content"
        >



        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_60sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            android:layout_margin="@dimen/_5sdp"
            android:id="@+id/cardView"
           android:layout_below="@id/ll_top"
            android:layout_height="@dimen/_60sdp"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/placeholder"
                android:id="@+id/room_image"
                android:scaleType="centerCrop"
                android:layout_height="match_parent"
                ></androidx.appcompat.widget.AppCompatImageView>
        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:id="@+id/rl_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ll_top"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_toRightOf="@id/cardView">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_owner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_toRightOf="@id/rm_size"
                android:textColor="@color/black"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/rm_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Size:"
                android:textColor="@color/black"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_rent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:maxWidth="@dimen/_100sdp"
                android:textColor="#0BCD0D"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_2"
            android:id="@+id/rl_fav"
            android:visibility="gone"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/heart_fill"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/ic_baseline_favorite_24"
                android:visibility="visible"></ImageView>

            <ImageView
                android:id="@+id/heart_empty"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/ic_baseline_favorite_border_24"
                android:visibility="gone"></ImageView>

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rl_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_1"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_toRightOf="@id/cardView">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_location"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:src="@drawable/ic_baseline_location_on_24"></androidx.appcompat.widget.AppCompatImageView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_toRightOf="@id/img_location"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_ratting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_2"
            android:layout_toRightOf="@id/cardView">


            <RatingBar
                android:id="@+id/ratingBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:isIndicator="true"
                android:numStars="5"
                android:visibility="gone"
                android:progressBackgroundTint="#B6720D"
                android:progressTint="#ffff8800"
                android:rating="3"
                android:stepSize="0.1" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/top_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"

                android:layout_marginBottom="@dimen/_7sdp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_Activate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10sdp"
                    app:cardBackgroundColor="#11D504"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textSize="@dimen/_9sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:text="Activated"
                        android:textColor="@color/white"></TextView>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_De_Activate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#A10214"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textSize="@dimen/_9sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:text="Deactivated"
                        android:textColor="@color/white"></TextView>
                </androidx.cardview.widget.CardView>

            </RelativeLayout>


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                android:paddingRight="@dimen/_10sdp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"

                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_9sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_2sdp"
                        android:text="Edit">

                    </TextView>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/_2sdp"

                    android:layout_marginBottom="@dimen/_2sdp"
                    android:layout_toRightOf="@+id/card_edit"
                    app:cardBackgroundColor="@color/red"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:textSize="@dimen/_9sdp"
                        android:layout_marginVertical="@dimen/_2sdp"
                        android:text="Delete"
                        android:textColor="@color/white">

                    </TextView>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

        </RelativeLayout>



    </RelativeLayout>

</androidx.cardview.widget.CardView>