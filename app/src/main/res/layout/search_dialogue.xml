<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    app:cardCornerRadius="@dimen/_10sdp"
    android:layout_margin="@dimen/_10sdp"
    android:layout_height="wrap_content">

     <RelativeLayout
         android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_40sdp"
         android:layout_height="match_parent"
         >
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_marginTop="@dimen/_40sdp"
               android:layout_height="wrap_content"
               android:id="@+id/rl_top"
               android:visibility="gone"
               android:layout_marginLeft="@dimen/_10sdp"
               android:layout_marginRight="@dimen/_10sdp"
               >
                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:hint="Search here"
                    android:id="@+id/ed_search"
                    android:paddingLeft="@dimen/_10sdp"
                    android:background="@drawable/edittextshap"
                    android:inputType="text"
                    ></androidx.appcompat.widget.AppCompatEditText>

              <RelativeLayout
                  android:layout_width="@dimen/_25sdp"
                  android:layout_alignParentEnd="true"
                  android:layout_centerVertical="true"
                  android:layout_height="@dimen/_30sdp"
                  >

                  <androidx.appcompat.widget.AppCompatImageView
                      android:id="@+id/img_filter"
                      android:layout_width="wrap_content"
             android:visibility="gone"
                      android:layout_height="match_parent"
                      android:src="@drawable/ic_baseline_filter_alt_24"></androidx.appcompat.widget.AppCompatImageView>
<!--                   <View-->
<!--                   android:layout_width="@dimen/_2sdp"-->
<!--                   android:layout_height="@dimen/_25sdp"-->
<!--                       android:id="@+id/line"-->
<!--                       android:paddingRight="@dimen/_5sdp"-->
<!--                       android:background="@color/red"-->
<!--                       android:layout_centerInParent="true"-->
<!--                      android:rotation="40"-->
<!--                   android:src="@drawable/ic_baseline_filter_alt_24"-->
<!--                   ></View>-->
              </RelativeLayout>

           </RelativeLayout>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_below="@+id/rl_top"
                  android:layout_marginLeft="@dimen/_10sdp"
                  android:layout_marginRight="@dimen/_10sdp"
                  android:weightSum="3"
                  android:visibility="visible"
                  android:orientation="vertical"
                  android:id="@+id/ll_top2"
                  android:layout_marginTop="@dimen/_20sdp"
                  android:layout_height="wrap_content">
                  <TextView
                      android:layout_width="wrap_content"
                      android:text="Size"
                      android:layout_marginTop="@dimen/_5sdp"
                      android:layout_marginLeft="@dimen/_8sdp"
                      android:layout_height="wrap_content"
                      ></TextView>
                  <RelativeLayout
                      android:layout_width="match_parent"
                      android:layout_height="45dp"
                      android:layout_weight="1"
                      android:layout_marginLeft="@dimen/_5sdp"
                      android:background="@drawable/edittextshap"
                      android:layout_marginTop="@dimen/_8sdp"
                      >

                      <Spinner
                          android:id="@+id/sp_Size"
                          style="@style/spinner_style"
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"

                          android:layout_centerInParent="true"
                          android:layout_marginLeft="@dimen/_5sdp"
                          android:dropDownSelector="@drawable/ic_baseline_keyboard_arrow_down_24"
                          android:elevation="@dimen/_10sdp"
                          android:verticalScrollbarPosition="right"></Spinner>
                  </RelativeLayout>

                  <TextView
                    android:layout_marginLeft="@dimen/_7sdp"
                      android:layout_width="wrap_content"
                      android:layout_marginTop="@dimen/_15sdp"
                      android:layout_height="wrap_content"
                      android:text="Rent"></TextView>
                  <RelativeLayout
                      android:layout_width="match_parent"
                      android:layout_height="45dp"
                      android:layout_marginLeft="@dimen/_5sdp"
                      android:layout_weight="1"
                      android:background="@drawable/edittextshap"
                      android:layout_marginTop="@dimen/_8sdp"
                      >
                      <Spinner
                          android:layout_width="match_parent"
                          android:id="@+id/sp_price"                        style="@style/spinner_style"
                          android:dropDownSelector="@drawable/ic_baseline_keyboard_arrow_down_24"
                          android:verticalScrollbarPosition="right"
                          android:layout_centerInParent="true"
                          android:elevation="@dimen/_10sdp"
                          android:layout_height="match_parent"
                          ></Spinner>
                  </RelativeLayout>
                  <TextView
                      android:layout_width="wrap_content"
                      android:text="Rating"
                      android:layout_marginTop="@dimen/_15sdp"
                      android:layout_marginLeft="@dimen/_7sdp"
                      android:layout_height="wrap_content"
                      ></TextView>
                  <RelativeLayout
                      android:layout_width="match_parent"
                      android:layout_height="45dp"
                      android:layout_weight="1"
                    android:layout_marginLeft="@dimen/_5sdp"
                      android:background="@drawable/edittextshap"
                      android:layout_marginTop="@dimen/_8sdp"
                      >
                      <Spinner
                          android:layout_width="match_parent"
                          android:id="@+id/sp_Rating"
                          style="@style/spinner_style"
                          android:dropDownSelector="@drawable/ic_baseline_keyboard_arrow_down_24"
                          android:verticalScrollbarPosition="right"
                          android:layout_centerInParent="true"
                          android:elevation="@dimen/_10sdp"
                          android:layout_height="match_parent"
                          ></Spinner>
                  </RelativeLayout>


              </LinearLayout>

         <Button
             android:id="@+id/submit"
             android:layout_width="match_parent"
             android:layout_height="45dp"
           android:layout_below="@id/ll_top2"
             android:layout_weight="1"
             android:layout_marginLeft="@dimen/_50sdp"
             android:layout_marginRight="@dimen/_50sdp"
             android:layout_marginTop="@dimen/_20sdp"
             android:background="@drawable/mybutton"
             android:foreground="?android:attr/selectableItemBackground"
             android:text="Submit"
             android:textAllCaps="false"
             android:textColor="@color/white"></Button>

     </RelativeLayout>
</androidx.cardview.widget.CardView>