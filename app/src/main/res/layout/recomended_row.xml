<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_190sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/_5sdp"
    android:layout_margin="@dimen/_5sdp"
    app:cardElevation="@dimen/_2sdp"
    android:elevation="@dimen/_2sdp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_room_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"
            ></androidx.appcompat.widget.AppCompatImageView>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_alignParentEnd="true"
            app:cardCornerRadius="@dimen/_3sdp"
            android:visibility="gone"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_height="@dimen/_15sdp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:alpha=".4"
                android:background="@color/white"
                android:layout_height="match_parent"
                ></RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_centerInParent="true"
                android:layout_height="match_parent"
                >

                <ImageView
                    android:id="@+id/star"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_marginLeft="@dimen/_2sdp"
                    android:layout_toRightOf="@id/tv_ratting"
                    android:src="@drawable/ic_baseline_star_24"></ImageView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_ratting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:textColor="@color/darktextColor"
                    android:textSize="@dimen/_8sdp"></androidx.appcompat.widget.AppCompatTextView>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/img_room_image"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_12sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_room_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/darktextColor"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"></androidx.appcompat.widget.AppCompatTextView>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_room_type"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_3sdp">

                <ImageView
                    android:id="@+id/heart_fill"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_baseline_favorite_24"
                    android:visibility="gone"></ImageView>

                <ImageView
                    android:id="@+id/heart_empty"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_baseline_favorite_border_24"></ImageView>

            </RelativeLayout>


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_location"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_below="@+id/tv_room_type"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/_2sdp"
                android:src="@drawable/ic_baseline_location_black"></androidx.appcompat.widget.AppCompatImageView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_location"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_room_type"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_toRightOf="@+id/img_location"
                android:textSize="@dimen/_8sdp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_rent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_3sdp"
                android:textColor="@color/themedark"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>

        </RelativeLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>