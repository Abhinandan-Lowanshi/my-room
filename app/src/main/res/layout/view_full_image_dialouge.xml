<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/themedark"
    app:cardCornerRadius="@dimen/_20sdp"
    android:layout_margin="@dimen/_7sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">


     <RelativeLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         >
    <ImageView
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:id="@+id/img_close"
        android:visibility="visible"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_baseline_close_24"
        ></ImageView>




<!--        <ImageView-->
<!--            android:id="@+id/main_image"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent"-->
<!--            android:layout_centerInParent="true"-->
<!--            android:src="@drawable/room_image"></ImageView>-->

         <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
             android:id="@+id/imViewedImage"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:layout_below="@+id/img_close"
             android:src="@drawable/placeholder"
             android:clickable="true"
             android:focusable="true" />


        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:id="@+id/card_left"
            android:visibility="visible"
            app:cardCornerRadius="@dimen/_90sdp"
            android:layout_alignParentLeft="true"
            >
    <ImageView
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:id="@+id/count_left"
        android:visibility="visible"
        android:src="@drawable/left_arrow"

        ></ImageView>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/card_right"
            android:visibility="visible"
            android:layout_centerVertical="true"
            app:cardCornerRadius="@dimen/_90sdp"
            android:layout_alignParentRight="true"
            >
     <ImageView
        android:layout_width="@dimen/_35sdp"
         android:visibility="visible"
        android:layout_height="@dimen/_35sdp"
         android:id="@+id/count_right"
        android:src="@drawable/right_arrow"
        ></ImageView>
        </androidx.cardview.widget.CardView>
     </RelativeLayout>
</androidx.cardview.widget.CardView>