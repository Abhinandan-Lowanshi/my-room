<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0CDD5"
        android:id="@+id/scrollview"
        android:layout_weight="1"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="horizontal">

            <ImageView
                android:layout_width="400dp"
                android:scaleType="centerCrop"
                android:layout_height="400dp"
               android:id="@+id/m11"
                android:layout_marginLeft="5dp"
                android:adjustViewBounds="true"



                ></ImageView>

            <ImageView
                android:id="@+id/m22"

                android:layout_width="400dp"

                android:layout_height="400dp"
                android:layout_marginLeft="5dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"></ImageView>

            <ImageView
                android:layout_width="400dp"

                android:layout_height="400dp"
                android:layout_marginLeft="5dp"
                android:id="@+id/m33"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"></ImageView>

            <ImageView
                android:layout_width="400dp"

                android:layout_height="400dp"
                android:adjustViewBounds="true"
                android:layout_marginLeft="5dp"

                android:id="@+id/m44"
                android:scaleType="centerCrop"
                ></ImageView>
        </LinearLayout>


    </HorizontalScrollView>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="25dp"
        android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:layout_height="match_parent"
                >
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Name"
                        android:textSize="12dp"

                        android:textColor="@color/black"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="20dp"
                        android:layout_height="wrap_content"></TextView>
                    <TextView
                        android:id="@+id/Rnamr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:textSize="12dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:text="Null"
                        ></TextView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:text="House No"
                        android:textSize="12dp"
                        android:textColor="@color/black"

                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="20dp"
                        android:layout_height="wrap_content"></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/Rhouse"
                        android:textSize="12dp"

                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:text="Null"
                        ></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="City"
                        android:textSize="12dp"
                        android:textColor="@color/black"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="20dp"
                        android:layout_height="wrap_content"></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/Rcity"

                        android:textSize="12dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:text="Null"
                        ></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Avaiable for"
                        android:textSize="12dp"
                        android:textColor="@color/black"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="20dp"

                        android:layout_height="wrap_content"></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/Ravaiable"
                        android:textSize="12dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:text="Null"
                        ></TextView>
                    <TextView
                        android:layout_width="wrap_content"

                        android:textSize="12dp"
                        android:text="Independent or not"
                        android:textColor="@color/black"
                        android:layout_marginTop="12dp"
                        android:layout_marginLeft="20dp"
                        android:layout_height="wrap_content"></TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/Rindependent"
                        android:textSize="12dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:text="Null"
                        ></TextView>

                </LinearLayout> <LinearLayout
                    android:orientation="vertical"
                android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >
                <TextView
                    android:layout_width="wrap_content"
                    android:textSize="12dp"
                    android:text="Size"

                    android:textColor="@color/black"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="20dp"
                    android:layout_height="wrap_content"></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/Rsize"
                    android:textSize="12dp"

                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Null"
                    ></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="Colony"
                    android:textSize="12dp"

                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="20dp"
                    android:layout_height="wrap_content"></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/Rcolony"
                    android:textSize="12dp"

                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Null"
                    ></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:text="Rent"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"

                    android:textSize="12dp"
                    android:layout_marginLeft="20dp"
                    android:layout_height="wrap_content"></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/Rrent"

                    android:textSize="12dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Null"
                    ></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"

                    android:textSize="12dp"
                    android:layout_marginTop="12dp"
                    android:text="Mobile No"
                    android:textColor="@color/black"></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/Rmobile"

                    android:textSize="12dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Null"
                    ></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="Upload Date"
                    android:layout_marginRight="5dp"

                    android:textSize="12dp"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"

                    android:layout_height="wrap_content"></TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:id="@+id/Rupload"

                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Null"
                    android:layout_marginBottom="15dp"
                    ></TextView>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_gravity="right"
                    android:id="@+id/SavedLayout"
                    android:layout_marginRight="30dp"
                    android:background="@color/save"
                    android:layout_height="wrap_content"
                    >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="right"
                    android:id="@+id/checkImage"
                   android:src="@drawable/uncheck"
                    android:background="@color/white"
                  android:layout_marginRight="5dp"

                    android:layout_height="wrap_content"
                    ></ImageView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Save"
                        android:id="@+id/checktext"
                        android:layout_marginTop="2dp"

                        android:layout_height="wrap_content"
                        ></TextView>
                </LinearLayout>

            </LinearLayout>

            </LinearLayout>
    </androidx.cardview.widget.CardView>
+
    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_marginBottom="20dp"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"

        android:background="?android:attr/listDivider" />



</LinearLayout>