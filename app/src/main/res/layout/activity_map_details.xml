<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:weightSum="1"
    android:layout_height="match_parent"
    tools:context=".app.map.MapDetailsActivity">

     <LinearLayout
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:layout_height="match_parent"
         >

         <fragment
             android:id="@+id/map"
             class="com.google.android.gms.maps.SupportMapFragment"
             android:layout_width="match_parent"


             android:layout_height="match_parent" />

     </LinearLayout>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:paddingRight="15dp"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/theme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_22sdp"
                android:id="@+id/img_back"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/ic_baseline_keyboard_backspace_24"
                ></androidx.appcompat.widget.AppCompatImageView>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               android:layout_toRightOf="@id/img_back"
                android:text="@string/route_details"
                android:textColor="@color/theme_green"
                android:textSize="@dimen/_14sdp"

                android:visibility="visible"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_height="@dimen/_20sdp"
                android:id="@+id/img_search"
                android:visibility="gone"
                android:layout_toLeftOf="@+id/img_notification"
                android:src="@drawable/ic_baseline_search_24"
                ></androidx.appcompat.widget.AppCompatImageView>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:id="@+id/img_notification"
                android:visibility="gone"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_baseline_notifications_none_24"
                ></androidx.appcompat.widget.AppCompatImageView>

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:visibility="gone"
        android:id="@+id/single_bar"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_below="@id/toolbar"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        >
        <View
            android:layout_width="@dimen/_2sdp"
            android:background="@color/red"
            android:alpha=".3"
            android:id="@+id/single_1"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_height="@dimen/_7sdp"
            ></View>
        <View
            android:layout_width="@dimen/_2sdp"
            android:background="#D86262"
            android:alpha=".3"
            android:id="@+id/single_2"

            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_height="@dimen/_10sdp"
            ></View>
        <View
            android:layout_width="@dimen/_2sdp"
            android:background="#46C648"
            android:id="@+id/single_3"

            android:alpha=".3"
            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_height="@dimen/_13sdp"
            ></View>
        <View
            android:layout_width="@dimen/_2sdp"
            android:background="#15AE10"
            android:alpha=".3"
            android:id="@+id/single_4"

            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_height="@dimen/_16sdp"
            ></View>
        <View
            android:layout_width="@dimen/_2sdp"
            android:background="#0AAC06"
            android:alpha=".3"
            android:id="@+id/single_5"

            android:layout_marginLeft="@dimen/_2sdp"
            android:layout_height="@dimen/_19sdp"
            ></View>

        <TextView
            android:layout_width="wrap_content"
            android:id="@+id/accuracy"
            android:textSize="@dimen/_8sdp"
            android:layout_marginLeft="@dimen/_3sdp"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_below="@+id/single_bar"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@color/white"
        android:padding="@dimen/_5sdp"
        android:alpha=".87"

        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_address"
                android:textSize="@dimen/_9sdp"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="wrap_content"
                android:textColor="#131313"
                ></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_1sdp"
                android:textColor="#131313"

                ></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_duretion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_1sdp"
                android:textColor="#131313"

                ></androidx.appcompat.widget.AppCompatTextView>
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/start_tracking"
        android:textAllCaps="false"
        android:layout_marginBottom="@dimen/_50sdp"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
         android:text="Building route please wait...."
      ></TextView>


</RelativeLayout>