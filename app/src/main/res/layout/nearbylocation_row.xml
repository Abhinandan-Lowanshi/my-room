<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    app:cardCornerRadius="@dimen/_5sdp"
    android:elevation="@dimen/_10sdp"
    app:cardElevation="@dimen/_10sdp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/rl_main"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_height="wrap_content"
        >
         <androidx.cardview.widget.CardView
             android:layout_width="@dimen/_60sdp"
             app:cardCornerRadius="@dimen/_8sdp"
             android:layout_margin="@dimen/_5sdp"
             android:id="@+id/cardView"

             android:layout_height="@dimen/_60sdp"
             >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/placeholder"
            android:id="@+id/room_image"
            android:scaleType="centerCrop"
            android:layout_height="match_parent"
            ></androidx.appcompat.widget.AppCompatImageView>
         </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:id="@+id/rl_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_toRightOf="@id/cardView">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_owner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_10sdp"

                android:layout_toRightOf="@id/rm_size"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/rm_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Size:"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_rent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:text="$3400"
                android:textColor="#0BCD0D"
                android:textSize="@dimen/_9sdp"></androidx.appcompat.widget.AppCompatTextView>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/rl_1"
            android:id="@+id/rl_2"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_toRightOf="@id/cardView"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_location"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:src="@drawable/ic_baseline_location_on_24"></androidx.appcompat.widget.AppCompatImageView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_toRightOf="@id/img_location"
                android:text="971 Lakshmi nagar"></androidx.appcompat.widget.AppCompatTextView>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_2"
            android:layout_toRightOf="@id/cardView">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               android:layout_marginTop="@dimen/_10sdp"
               android:layout_marginRight="@dimen/_20sdp"
                android:layout_alignParentEnd="true">

                <ImageView
                    android:id="@+id/heart_fill"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_baseline_favorite_24"
                    android:visibility="visible"></ImageView>

                <ImageView
                    android:id="@+id/heart_empty"
                    android:layout_width="@dimen/_17sdp"
                    android:visibility="gone"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:src="@drawable/ic_baseline_favorite_border_24"></ImageView>

            </RelativeLayout>


            <RatingBar
                android:id="@+id/ratingBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:isIndicator="true"
                android:numStars="5"
                android:visibility="gone"
                android:progressBackgroundTint="#B6720D"
                android:progressTint="#ffff8800"
                android:rating="3"
                android:stepSize="0.1" />

