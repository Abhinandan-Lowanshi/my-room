<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/container"
    tools:context=".app.fragment.activity.NewHomeActivityFR">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:paddingRight="15dp"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >


            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_7sdp"
                app:cardCornerRadius="@dimen/_90sdp"
                android:visibility="visible"
                android:id="@+id/card_green"
                android:layout_marginRight="@dimen/_3sdp"
                android:layout_toLeftOf="@+id/no_internet"
                android:layout_centerInParent="true"
                android:layout_height="@dimen/_7sdp"
                >
                <View
                    android:layout_width="match_parent"
                    android:background="@color/theme_green"
                    android:layout_height="match_parent"
                    ></View>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_7sdp"
                app:cardCornerRadius="@dimen/_90sdp"
                android:visibility="visible"
                android:id="@+id/card_red"
                android:layout_marginRight="@dimen/_3sdp"
                android:layout_toLeftOf="@+id/no_internet"
                android:layout_centerInParent="true"
                android:layout_height="@dimen/_7sdp"
                >
                <View
                    android:layout_width="match_parent"
                    android:background="@color/red"
                    android:layout_height="match_parent"
                    ></View>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/no_internet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textSize="@dimen/_9sdp"
                android:textColor="@color/black"></TextView>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/my"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="My"
                    android:textSize="@dimen/_15sdp"
                    ></TextView>   <TextView
                android:id="@+id/myroom"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textColor="#DA9E3C"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Room"
                android:textSize="@dimen/_15sdp"
                ></TextView>


            </LinearLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"

                android:textColor="@color/theme_green"
                android:textSize="@dimen/_15sdp"
                android:visibility="gone"

                ></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_search"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_centerInParent="true"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_toLeftOf="@+id/img_chat"
                android:src="@drawable/ic_baseline_search_24"></androidx.appcompat.widget.AppCompatImageView>


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_chat"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_centerInParent="true"
                android:layout_marginRight="@dimen/_10sdp"
                android:visibility="gone"
                android:layout_toLeftOf="@+id/img_notification"
                android:src="@drawable/ic_baseline_chat_24"></androidx.appcompat.widget.AppCompatImageView>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_notification"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_notifications_none_24"></androidx.appcompat.widget.AppCompatImageView>

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>
     <RelativeLayout
         android:layout_width="match_parent"
         android:id="@+id/main_rl"
         android:layout_below="@id/toolbar"
         android:layout_height="match_parent"
         >




         <FrameLayout
             android:id="@+id/main_container"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:layout_above="@id/bottom_nav_bar"
             ></FrameLayout>

         <com.ismaeldivita.chipnavigation.ChipNavigationBar
             android:id="@+id/bottom_nav_bar"
             android:layout_width="match_parent"
             android:layout_height="@dimen/_45sdp"
             android:layout_alignParentBottom="true"
             android:layout_gravity="bottom"
             android:fadingEdge="horizontal"
             app:cnb_radius="@dimen/_18sdp"
             app:cnb_badgeColor="@color/red"
             app:itemTextAppearanceActive="@style/MenuItems"
             app:cnb_menuResource="@menu/nav_menu"
             app:cnb_iconSize = "@dimen/_14sdp"
             app:cnb_textAppearance="@color/quantum_yellow"
             app:cnb_unselectedColor="#50504E" />
     </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/no_internet_rl"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/_30sdp"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/meessage"
            android:layout_centerInParent="true"
            android:text="Oops no internet connection"
            android:textColor="@color/black"
            android:textFontWeight="600"
            android:textSize="@dimen/_15sdp"></TextView>

        <TextView
            android:id="@+id/meessage"
            android:layout_width="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_height="wrap_content"
            android:layout_above="@+id/no_data_found"
            android:layout_centerHorizontal="true"
            android:text="Try again later"
            android:textColor="@color/black"
            android:textFontWeight="600"
            android:textSize="@dimen/_15sdp"></TextView>

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/no_data_found"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:src="@drawable/no_internet" />
    </RelativeLayout>

</RelativeLayout>