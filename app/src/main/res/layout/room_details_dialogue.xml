<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    app:cardCornerRadius="@dimen/_10sdp"
    android:layout_margin="@dimen/_10sdp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_height="match_parent"
        >
         <ImageView
             android:layout_width="wrap_content"
             android:layout_gravity="end"
             android:id="@+id/img_close"
             android:layout_alignParentEnd="true"
             android:layout_marginRight="@dimen/_10sdp"
             android:src="@drawable/ic_baseline_close_24"
             android:layout_height="wrap_content"
             ></ImageView>

           <androidx.cardview.widget.CardView
               android:layout_below="@+id/img_close"
               android:layout_marginTop="@dimen/_10sdp"
               android:layout_height="@dimen/_80sdp"
               android:elevation="@dimen/_10sdp"
               android:id="@+id/top_card_view"
               app:cardElevation="@dimen/_10sdp"
               app:cardCornerRadius="@dimen/_8sdp"
               android:layout_marginLeft="@dimen/_10sdp"
               android:layout_width="@dimen/_90sdp"

               >
          <ImageView
              android:layout_width="match_parent"
              android:id="@+id/img_room_image"
              android:src="@drawable/room_image"
              android:layout_height="match_parent"
              ></ImageView>
           </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/img_close"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_13sdp"
            android:layout_toRightOf="@id/top_card_view"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_owner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abhinandan lowanshi"
                android:textColor="@color/black"></TextView>

            <TextView
                android:id="@+id/tv_owner_mobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="+91 7049836854"
                android:textColor="@color/black"></TextView>

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="Single room"
                android:textColor="@color/black"></TextView>

            <TextView
                android:id="@+id/tv_rent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="5400"
                android:textColor="@color/black"></TextView>

            <TextView
                android:id="@+id/tv_full_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="House no 84 , vijay nagar , indore"
                android:textColor="@color/black"></TextView>

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_top"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:id="@+id/tv_view_full_details"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="View full details"
            android:textColor="#124EE6"></TextView>

    </RelativeLayout>
</androidx.cardview.widget.CardView>